+def sparse_topk(logits: torch.Tensor, kp: int) -> tuple[torch.Tensor, torch.Tensor]:
+    """Return sorted top-k logits and unique int64 token ids in two launches."""
+    if logits.ndim != 2 or logits.stride(1) != 1:
+        raise ValueError("logits must be a matrix with contiguous rows")
+    if logits.dtype not in (torch.float32, torch.bfloat16):
+        raise ValueError("logits must have dtype float32 or bfloat16")
+    if not isinstance(kp, int) or not 16 <= kp <= 256 or kp & (kp - 1):
+        raise ValueError("kp must be a power of two between 16 and 256")
+    num_rows, vocab = logits.shape
+    if kp > vocab:
+        raise ValueError("kp must not exceed the vocabulary size")
+    vals = torch.empty(size=(num_rows, kp), dtype=logits.dtype, device=logits.device)
+    idx = torch.empty(size=(num_rows, kp), dtype=torch.int64, device=logits.device)
+    if num_rows == 0:
+        return vals, idx
+    chunk_size = 4096
+    num_chunks = triton.cdiv(vocab, chunk_size)
+    num_candidates = num_chunks * kp
+    candidates = torch.empty(
+        size=(num_rows, num_candidates), dtype=torch.int64, device=logits.device
+    )
+    _sparse_topk_chunks_kernel[(num_rows, num_chunks)](
+        Logits=logits,
+        Candidates=candidates,
+        stride_row=logits.stride(0),
+        VOCAB=vocab,
+        NUM_CHUNKS=num_chunks,
+        KP=kp,
+        BLOCK=chunk_size,
+        LOG_K=kp.bit_length() - 1,
+        LOG_BLOCK=chunk_size.bit_length() - 1,
+        num_warps=4,
+    )
+    merge_block = triton.next_power_of_2(num_candidates)
+    _sparse_topk_merge_kernel[(num_rows,)](
+        Candidates=candidates,
+        Vals=vals,
+        Idx=idx,
+        NUM_CANDIDATES=num_candidates,
+        KP=kp,
+        BLOCK=merge_block,
+        LOG_K=kp.bit_length() - 1,
+        LOG_BLOCK=merge_block.bit_length() - 1,
+        num_warps=4 if merge_block <= 4096 else 8,
+    )
+    return vals, idx
+
