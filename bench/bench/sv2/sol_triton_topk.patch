+@triton.jit
+def _sparse_topk_bitonic_merge(keys, STAGE: tl.constexpr, ALTERNATING: tl.constexpr):
+    offs = tl.arange(start=0, end=keys.numel)
+    flip = (offs & (1 << STAGE)) != 0 if ALTERNATING else True
+    for i in tl.static_range(arg1=STAGE - 1, arg2=-1, step=-1):
+        # Static pair permutations avoid the interpreter's generic XOR reduction.
+        pairs = keys.reshape((keys.numel // (2 << i), 2, 1 << i)).permute((0, 2, 1))
+        left, right = tl.split(pairs)
+        partner = tl.join(a=right, b=left).permute((0, 2, 1)).reshape(keys.shape)
+        is_right = (offs & (1 << i)) != 0
+        keys = tl.where(condition=(keys > partner) != (flip ^ is_right), x=partner, y=keys)
+    return keys
+
+
+@triton.jit
+def _sparse_topk_select(keys, KP: tl.constexpr, LOG_K: tl.constexpr, LOG_BLOCK: tl.constexpr):
+    for stage in tl.static_range(arg1=1, arg2=LOG_K + 1):
+        keys = _sparse_topk_bitonic_merge(
+            keys=keys, STAGE=stage, ALTERNATING=stage < LOG_BLOCK
+        )
+    for stage in tl.static_range(arg1=LOG_K + 1, arg2=LOG_BLOCK + 1):
+        pairs = keys.reshape((keys.numel // (2 * KP), 2, KP))
+        keys = tl.max(input=pairs, axis=1).reshape((keys.numel // 2,))
+        keys = _sparse_topk_bitonic_merge(
+            keys=keys, STAGE=LOG_K, ALTERNATING=stage < LOG_BLOCK
+        )
+    return keys
+
+
+@triton.jit
+def _sparse_topk_chunks_kernel(
+    Logits,
+    Candidates,
+    stride_row,
+    VOCAB: tl.constexpr,
+    NUM_CHUNKS: tl.constexpr,
+    KP: tl.constexpr,
+    BLOCK: tl.constexpr,
+    LOG_K: tl.constexpr,
+    LOG_BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    chunk = tl.program_id(1)
+    ids = chunk * BLOCK + tl.arange(start=0, end=BLOCK)
+    x = tl.load(
+        pointer=Logits + row * stride_row + ids, mask=ids < VOCAB, other=-float("inf")
+    ).to(tl.float32)
+    bits = x.to(dtype=tl.uint32, bitcast=True)
+    ordered = tl.where(
+        condition=(bits & 0x80000000) != 0, x=bits ^ 0xFFFFFFFF, y=bits ^ 0x80000000
+    )
+    # High bits order floats exactly; low bits prefer smaller ids, including -inf ties.
+    keys = (ordered.to(tl.uint64) << 32) | (0xFFFFFFFF - ids.to(tl.uint32)).to(tl.uint64)
+    keys = tl.where(condition=ids < VOCAB, x=keys, y=0)
+    top = _sparse_topk_select(keys=keys, KP=KP, LOG_K=LOG_K, LOG_BLOCK=LOG_BLOCK)
+    offs = (row * NUM_CHUNKS + chunk) * KP + tl.arange(start=0, end=KP)
+    tl.store(pointer=Candidates + offs, value=top)
+
+
+@triton.jit
+def _sparse_topk_merge_kernel(
+    Candidates,
+    Vals,
+    Idx,
+    NUM_CANDIDATES: tl.constexpr,
+    KP: tl.constexpr,
+    BLOCK: tl.constexpr,
+    LOG_K: tl.constexpr,
+    LOG_BLOCK: tl.constexpr,
+):
+    row = tl.program_id(0)
+    offs = tl.arange(start=0, end=BLOCK)
+    keys = tl.load(
+        pointer=Candidates + row * NUM_CANDIDATES + offs,
+        mask=offs < NUM_CANDIDATES,
+        other=0,
+    ).to(tl.uint64)
+    top = _sparse_topk_select(keys=keys, KP=KP, LOG_K=LOG_K, LOG_BLOCK=LOG_BLOCK)
+    ordered = (top >> 32).to(tl.uint32)
+    bits = tl.where(
+        condition=(ordered & 0x80000000) != 0,
+        x=ordered ^ 0x80000000,
+        y=ordered ^ 0xFFFFFFFF,
+    )
+    vals = bits.to(dtype=tl.float32, bitcast=True)
+    ids = 0xFFFFFFFF - (top & 0xFFFFFFFF).to(tl.uint32)
+    out = row * KP + tl.arange(start=0, end=KP)
+    tl.store(pointer=Vals + out, value=vals)
+    tl.store(pointer=Idx + out, value=ids.to(tl.int64))
+
