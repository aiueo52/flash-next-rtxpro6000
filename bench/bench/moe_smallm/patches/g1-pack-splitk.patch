+// ===================== G1: active-group packing and GEMM1 split-K =====================
+//
+// Two independent, env-gated changes to how the grouped-GEMM *problem list* is built.  Neither
+// touches CUTLASS: the sm120 array kernel already re-derives every TMA descriptor's dims and
+// strides per group from `dA[g]` / `dB[g]` / `layout_SFA[g]` / `problem_shapes[g]`
+// (`sm120_blockscaled_mma_array_tma.hpp: tensormaps_replace_global_tensor_properties`), so a
+// K-slice with a full-K stride, and a permuted group order, are both legal inputs.
+//
+//  * FLASHINFER_MOE_PACK_GROUPS=1 -- write the D active experts into groups [0, D) instead of
+//    leaving them scattered over all `num_experts_per_node` slots.  The persistent tile
+//    scheduler walks the group list 32 at a time looking for its tile
+//    (`sm90_tile_scheduler_group.hpp: get_work_idx_m_and_n`), so at E=512 / D~28 it reads ~16x
+//    more problem shapes than it needs to.
+//  * FLASHINFER_MOE_SPLITK_GEMM1=1 -- additionally split GEMM1's K into `s` slices, emitted as
+//    `s` extra groups per active expert with FP32-accumulated BF16 partials summed by
+//    doActivationKernel.  `s` is chosen on the device from the measured active-expert count so
+//    that D*tiles*s is close to a whole number of 188-CTA waves.  Requires packing (the slices
+//    have to go somewhere) and `D*s <= num_experts_per_node`.
+//
+// Both fall back to the exact upstream layout when off, when the fused prologue declines, or
+// when any gate below fails.
+inline int moePackGroupsEnabled() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_PACK_GROUPS");
+    return (s && s[0] != '0') ? 1 : 0;
+  }();
+  return v;
+}
+
+// Packing pays for itself only when it actually shortens the group list a lot: the win is the
+// tile scheduler's 32-groups-per-iteration scan, and the cost is a fixed ~0.6 us of extra
+// prologue.  Measured on this box: at W4 (list 512 -> 40, 12.8x) it is -2.47 us/call; at W16
+// (512 -> 160, 3.2x) it is +0.14 us/call, i.e. a wash.  Require a 4x shortening by default.
+// FLASHINFER_MOE_PACK_MIN_RATIO=1 forces it on wherever it is legal.
+inline int moePackMinRatio() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_PACK_MIN_RATIO");
+    int n = s ? std::atoi(s) : 4;
+    return n < 1 ? 1 : n;
+  }();
+  return v;
+}
+
+// 0 = off.  1 = on with an automatic slice count (capped at 4).  n>1 = on, capped at n.
+inline int moeSplitKGemm1Max() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_SPLITK_GEMM1");
+    if (!s) return 0;
+    int n = std::atoi(s);
+    if (n <= 0) return 0;
+    return n == 1 ? 4 : (n > 8 ? 8 : n);
+  }();
+  return v;
+}
+
+// Per-wave ramp as a percentage of a full-K tile's streaming time.  Splitting K by `s` turns
+// `w` waves of (ramp + stream) into `w'` waves of (ramp + stream/s); this is the only knob that
+// decides whether that trade is worth taking.  Measured on this box, see specs/G1_LOG.md.
+inline int moeSplitKRampPct() {
+  static int const v = [] {
+    char const* s = std::getenv("FLASHINFER_MOE_SPLITK_RAMP_PCT");
+    int n = s ? std::atoi(s) : 25;
+    return (n < 0) ? 0 : (n > 400 ? 400 : n);
+  }();
+  return v;
+}
