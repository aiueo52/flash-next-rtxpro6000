+
+__host__ __device__ inline int chooseKSplits(int d_active, int tiles_per_group, int sm_count,
+                                             int max_slices, int max_groups, int max_k_units,
+                                             int ramp_pct) {
+  if (max_slices <= 1 || d_active <= 0 || tiles_per_group <= 0 || sm_count <= 0) return 1;
+  float const r = (float)ramp_pct * 0.01f;
+  int best_s = 1;
+  int waves1 = (d_active * tiles_per_group + sm_count - 1) / sm_count;
+  float best = (float)waves1 * (r + 1.0f);
+  for (int s = 2; s <= max_slices; ++s) {
+    if (d_active * s > max_groups) break;
+    if (s > max_k_units) break;
+    int waves = (d_active * tiles_per_group * s + sm_count - 1) / sm_count;
+    float cost = (float)waves * (r + 1.0f / (float)s);
+    if (cost < best - 1e-4f) {
+      best = cost;
+      best_s = s;
+    }
+  }
+  return best_s;
+}
+
+// Slice `j` of `s` over `units` K units, as [begin, end) in units.
+__host__ __device__ inline void kSliceUnits(int units, int s, int j, int* begin, int* end) {
+  int const base = units / s;
+  int const extra = units % s;
+  int b = j * base + (j < extra ? j : extra);
+  int e = b + base + (j < extra ? 1 : 0);
+  *begin = b;
+  *end = e;
+}
