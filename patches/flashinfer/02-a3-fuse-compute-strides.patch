+// ================= A3: routing prologue fused with the TMA descriptor setup ================
+//
+// computeStridesTmaWarpSpecializedKernel only depends on expert_first_token_offset, which the
+// routing prologue has just produced -- so it is one extra launch (2.9-4.5 us on sm120, entirely
+// serial dependency) per MoE call for work the prologue block already has in registers.
+//
+// The fusion keeps the strides phase exactly as parallel as it was (grid = ceil(E/32) blocks of
+// 32 threads, one thread per expert).  Every block re-runs the (cheap, deterministic) prologue so
+// that no grid-wide barrier is needed; only block 0 writes the routing maps to global memory.
+//
+// Restricted to BLOCK_SIZE = 32 (num_tokens <= 32, i.e. decode/verify) and LOG2_NUM_EXPERTS = 10
+// (num_experts_per_node + 1 < 1024) to keep the instantiation count to one per top-k value per
+// runner type.  Everything else falls back to the two separate launches.
+template <class T, class WeightType, class OutputType, class ScaleBiasType, int BLOCK_SIZE,
+          int EXPERTS_PER_TOKEN, int LOG2_NUM_EXPERTS>
+__global__ void fusedBuildExpertMapsSortFirstTokenAndStridesKernel(
+    int const* const token_selected_experts, int* const permuted_row_to_unpermuted_row,
+    int* const unpermuted_row_to_permuted_row, int64_t* const expert_first_token_offset,
+    int64_t const num_tokens, int const start_expert, int const end_expert,
+    int const num_experts_per_node, TmaWarpSpecializedGroupedGemmInput layout_info1,
+    TmaWarpSpecializedGroupedGemmInput layout_info2, int64_t gemm1_n, int64_t gemm1_k,
+    int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in, T const* gemm2_in,
+    WeightType const* weights1, WeightType const* weights2, float const* alpha_scale_flat1,
+    float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales) {
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+  static_assert(BlockRadixRank::BINS_TRACKED_PER_THREAD * BLOCK_SIZE >= (1 << LOG2_NUM_EXPERTS));
+  assert(num_experts_per_node < (1 << LOG2_NUM_EXPERTS));
+  assert(num_experts_per_node == (end_expert - start_expert));
+
+  extern __shared__ unsigned char temp_storage[];
+  auto& sort_temp = *reinterpret_cast<typename BlockRadixRank::TempStorage*>(temp_storage);
+  int* const shared_offsets =
+      reinterpret_cast<int*>(temp_storage + sizeof(typename BlockRadixRank::TempStorage));
+
+  int const token = threadIdx.x;
+  bool const is_valid_token = token < num_tokens;
+
+  int local_token_selected_experts[EXPERTS_PER_TOKEN];
+  int local_token_permuted_indices[EXPERTS_PER_TOKEN];
+
+#if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
+  cudaGridDependencySynchronize();
+#endif
+
+#pragma unroll
+  for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+    int const expert = is_valid_token ? token_selected_experts[token * EXPERTS_PER_TOKEN + i]
+                                      : num_experts_per_node;
+    bool is_valid_expert = expert >= start_expert && expert < end_expert;
+    local_token_selected_experts[i] = !is_valid_token   ? num_experts_per_node + 1
+                                      : is_valid_expert ? (expert - start_expert)
+                                                        : num_experts_per_node;
+  }
+
+  int local_expert_first_token_offset[BlockRadixRank::BINS_TRACKED_PER_THREAD];
+  cub::BFEDigitExtractor<int> extractor(0, LOG2_NUM_EXPERTS);
+  BlockRadixRank(sort_temp).RankKeys(local_token_selected_experts, local_token_permuted_indices,
+                                     extractor, local_expert_first_token_offset);
+
+  bool const writer_block = (blockIdx.x == 0);
+  if (writer_block && is_valid_token) {
+#pragma unroll
+    for (int i = 0; i < EXPERTS_PER_TOKEN; i++) {
+      int const unpermuted_row = i * num_tokens + token;
+      int const permuted_row = local_token_permuted_indices[i];
+      permuted_row_to_unpermuted_row[permuted_row] = unpermuted_row;
+      unpermuted_row_to_permuted_row[unpermuted_row] = permuted_row;
+    }
+  }
+
+#pragma unroll
+  for (int expert_id = 0; expert_id < BlockRadixRank::BINS_TRACKED_PER_THREAD; expert_id++) {
+    int out_expert_id = expert_id + token * BlockRadixRank::BINS_TRACKED_PER_THREAD;
+    if (out_expert_id < num_experts_per_node + 1) {
+      shared_offsets[out_expert_id] = local_expert_first_token_offset[expert_id];
+      if (writer_block) {
+        expert_first_token_offset[out_expert_id] = local_expert_first_token_offset[expert_id];
+      }
+    }
+  }
+  __syncthreads();
+
+  int const expert = blockIdx.x * BLOCK_SIZE + threadIdx.x;
+  if (expert < num_experts_per_node) {
+    computeStridesTmaWarpSpecializedForExpert<T, WeightType, OutputType, ScaleBiasType>(
+        expert, shared_offsets[expert], shared_offsets[expert + 1], layout_info1, layout_info2,
+        gemm1_n, gemm1_k, gemm2_n, gemm2_k, gemm1_in, gemm2_in, weights1, weights2,
+        alpha_scale_flat1, alpha_scale_flat2, fp4_act_flat1, fp4_act_flat2, quant_params, bias1,
+        bias2, gemm1_output, gemm2_output, router_scales, permuted_row_to_unpermuted_row);
+  }
+
 #if (defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 900))
   cudaTriggerProgrammaticLaunchCompletion();
 #endif
 }
 
+// FLASHINFER_MOE_FUSED_STRIDES=0 keeps computeStridesTmaWarpSpecialized as its own launch.
+inline bool fusedStridesEnabled() {
+  static bool const enabled = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FUSED_STRIDES");
+    return !(v && v[0] == '0' && v[1] == '\0');
+  }();
+  return enabled;
+}
+
+template <class T, class WeightType, class OutputType, class ScaleBiasType, int EXPERTS_PER_TOKEN>
+bool launchFusedPrologueAndStrides(
+    FusedPrologueRequest& req, TmaWarpSpecializedGroupedGemmInput layout_info1,
+    TmaWarpSpecializedGroupedGemmInput layout_info2, int const num_experts_per_node,
+    int64_t gemm1_n, int64_t gemm1_k, int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in,
+    T const* gemm2_in, WeightType const* weights1, WeightType const* weights2,
+    float const* alpha_scale_flat1, float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales, bool enable_pdl, cudaStream_t stream) {
+  constexpr int BLOCK_SIZE = 32;
+  constexpr int LOG2_NUM_EXPERTS = 10;
+  using BlockRadixRank = FusedPrologueRadixRank<BLOCK_SIZE, LOG2_NUM_EXPERTS>;
+
+  size_t const shared_size = sizeof(typename BlockRadixRank::TempStorage) +
+                             sizeof(int) * static_cast<size_t>(num_experts_per_node + 1);
+
+  int device = 0;
+  int max_smem_per_block = 0;
+  check_cuda_error(cudaGetDevice(&device));
+  check_cuda_error(
+      cudaDeviceGetAttribute(&max_smem_per_block, cudaDevAttrMaxSharedMemoryPerBlockOptin, device));
+  if (shared_size >= static_cast<size_t>(max_smem_per_block)) {
+    return false;
+  }
+
+  auto kernel = &fusedBuildExpertMapsSortFirstTokenAndStridesKernel<
+      T, WeightType, OutputType, ScaleBiasType, BLOCK_SIZE, EXPERTS_PER_TOKEN, LOG2_NUM_EXPERTS>;
+  check_cuda_error(
+      cudaFuncSetAttribute(kernel, cudaFuncAttributeMaxDynamicSharedMemorySize, shared_size));
+
+  cudaLaunchConfig_t config;
+  config.gridDim = (num_experts_per_node + BLOCK_SIZE - 1) / BLOCK_SIZE;
+  config.blockDim = BLOCK_SIZE;
+  config.dynamicSmemBytes = shared_size;
+  config.stream = stream;
+  cudaLaunchAttribute attrs[1];
+  attrs[0].id = cudaLaunchAttributeProgrammaticStreamSerialization;
+  attrs[0].val.programmaticStreamSerializationAllowed = enable_pdl;
+  config.numAttrs = 1;
+  config.attrs = attrs;
+
+  check_cuda_error(cudaLaunchKernelEx(
+      &config, kernel, req.token_selected_experts, req.permuted_row_to_unpermuted_row,
+      req.unpermuted_row_to_permuted_row, req.expert_first_token_offset, req.num_tokens,
+      req.start_expert, req.end_expert, num_experts_per_node, layout_info1, layout_info2, gemm1_n,
+      gemm1_k, gemm2_n, gemm2_k, gemm1_in, gemm2_in, weights1, weights2, alpha_scale_flat1,
+      alpha_scale_flat2, fp4_act_flat1, fp4_act_flat2, quant_params, bias1, bias2, gemm1_output,
+      gemm2_output, router_scales));
+  return true;
+}
+
+template <class T, class WeightType, class OutputType, class ScaleBiasType>
+bool tryFusedPrologueAndStrides(
+    FusedPrologueRequest& req, TmaWarpSpecializedGroupedGemmInput const& layout_info1,
+    TmaWarpSpecializedGroupedGemmInput const& layout_info2, int const num_experts_per_node,
+    int64_t gemm1_n, int64_t gemm1_k, int64_t gemm2_n, int64_t gemm2_k, T const* gemm1_in,
+    T const* gemm2_in, WeightType const* weights1, WeightType const* weights2,
+    float const* alpha_scale_flat1, float const* alpha_scale_flat2,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat1,
+    TmaWarpSpecializedGroupedGemmInput::ElementSF const* fp4_act_flat2, QuantParams quant_params,
+    ScaleBiasType const* bias1, ScaleBiasType const* bias2, OutputType* gemm1_output,
+    OutputType* gemm2_output, float const* router_scales, bool enable_pdl, cudaStream_t stream) {
+  if (!fusedPrologueEnabled() || !fusedStridesEnabled()) {
+    return false;
+  }
+  if (req.num_tokens > 32 || num_experts_per_node + 1 >= 1024 ||
+      num_experts_per_node != (req.end_expert - req.start_expert)) {
+    return false;
+  }
+  auto go = [&](auto tag) {
+    return launchFusedPrologueAndStrides<T, WeightType, OutputType, ScaleBiasType,
+                                         decltype(tag)::value>(
+        req, layout_info1, layout_info2, num_experts_per_node, gemm1_n, gemm1_k, gemm2_n, gemm2_k,
+        gemm1_in, gemm2_in, weights1, weights2, alpha_scale_flat1, alpha_scale_flat2, fp4_act_flat1,
+        fp4_act_flat2, quant_params, bias1, bias2, gemm1_output, gemm2_output, router_scales,
+        enable_pdl, stream);
+  };
+  switch (req.experts_per_token) {
+    case 1:
+      return go(std::integral_constant<int, 1>{});
+    case 2:
+      return go(std::integral_constant<int, 2>{});
+    case 4:
+      return go(std::integral_constant<int, 4>{});
+    case 6:
+      return go(std::integral_constant<int, 6>{});
+    case 8:
+      return go(std::integral_constant<int, 8>{});
+    case 10:
+      return go(std::integral_constant<int, 10>{});
+    default:
+      return false;
+  }
+}
