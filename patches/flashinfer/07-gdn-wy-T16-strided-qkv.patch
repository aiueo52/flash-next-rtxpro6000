+def _strided_qkv_ok(q, k, v, n_valid, H, HK, HV, K_dim, V_dim):
+    """True iff q/k/v can be read in place with one shared per-token row stride.
+
+    The kernel does not use the CuTe layouts of q/k/v at all: it takes their base
+    pointers (``gQ.iterator.toint()``) and addresses every element with the strides
+    rebuilt in ``_kernel_body`` as
+
+        base + b*(n_valid*rs) + t*rs + head*(K_DIM | V_DIM) + col
+
+    so the only stride it can absorb is the per-token one, and it must be the SAME
+    for q, k and v.  Everything else has to already be the canonical compact value:
+
+      * feature stride 1 and head stride K_DIM / V_DIM (features stay contiguous
+        inside a token in the conv-output column slices),
+      * batch stride exactly ``n_valid * rs`` (checked only when B > 1; at B == 1
+        the kernel multiplies it by pid_b == 0),
+      * ``rs`` a multiple of 8 elements and every base pointer 16 B aligned, because
+        the q/k/v loads are 16 B ``cp.async.ca`` (8 bf16) instructions.
+
+    The pre-existing native-short-T path only compared ``stride(1)``; a caller with
+    a non-canonical head or batch stride would have been read as garbage.  Using
+    this predicate there too can only turn the optimisation OFF (falling back to
+    ``.contiguous()``), never change a result.
+    """
+    rs = q.stride(1)
+    if k.stride(1) != rs or v.stride(1) != rs:
+        return False
+    if rs <= 0 or rs % 8 != 0:  # 16 B cp.async granularity
+        return False
+    for t, heads, feat in ((q, H, K_dim), (k, HK, K_dim), (v, HV, V_dim)):
+        if t.stride(-1) != 1:
+            return False
+        if heads > 1 and t.stride(2) != feat:
+            return False
+        if t.shape[0] > 1 and t.stride(0) != n_valid * rs:
+            return False
+        if (t.data_ptr() % 16) != 0:
+            return False
+    return True
