+//   1 = stage expert_first_token_offset in shared memory, then binary-search that  [default]
+//   2 = (1) + defer the PDL grid dependency wait to just before the first gemm_result read
+inline int fastActivationMode() {
+  static int const mode = [] {
+    char const* v = std::getenv("FLASHINFER_MOE_FAST_ACTIVATION");
+    if (!v || !v[0]) return 1;
+    int m = std::atoi(v);
+    return (m < 0 || m > 2) ? 1 : m;
+  }();
+  return mode;
+}
