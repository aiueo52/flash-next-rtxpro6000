+    )
+    if KERNEL_WIDTH == 2:
+        matrix_x0 = tl.where((idx_in0 == -1)[:, None], col0[None, :], matrix_x0)
+    elif KERNEL_WIDTH == 3:
+        matrix_x0 = tl.where((idx_in0 == -1)[:, None], col1[None, :], matrix_x0)
