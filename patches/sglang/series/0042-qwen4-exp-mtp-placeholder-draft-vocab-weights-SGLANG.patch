+        def build_lm_head() -> nn.Module:
+            return ParallelLMHead(
+                config.vocab_size,
+                config.hidden_size,
+                quant_config=quant_config,
+                prefix=add_prefix("model.shared_head.head", prefix),
+                use_attn_tp_group=get_parallel().config.enable_dp_lm_head,
+            )
