+"""CPU invariants for the QSA per-request pending index-key ring."""
+
+import random
+import unittest
+from types import SimpleNamespace
+
+import torch
+
+from sglang.srt.layers.attention.qsa.metadata import (
+    build_group_ring_slots,
+    build_pending_ring_slots,
