+    def _q(w: torch.Tensor):
+        wf = w.float()
+        amax = wf.abs().amax(dim=1).clamp(min=1e-12)
+        scale = amax / 448.0
+        q = (wf / scale[:, None]).clamp(-448.0, 448.0).to(torch.float8_e4m3fn)
+        return q.contiguous(), scale.contiguous()
