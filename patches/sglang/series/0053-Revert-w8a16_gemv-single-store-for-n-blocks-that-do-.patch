From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: aiueo52 <aiueo52@users.noreply.github.com>
Date: Sat, 5 Sep 2026 16:01:48 +0900
Subject: [PATCH 053/105] Revert "w8a16_gemv: single store for n blocks that do
 not straddle the split"

This reverts commit 633f70f5ff. The uniform-block branch was a measured
regression in the server, not a win: in_proj_ba (bf16, N=96, K=2560, 3 CTAs,
BLOCK_N=32, split 48) at M=16 went 6.7 us unsplit -> 7.6 us with the plain
two-masked-store epilogue -> 8.0 us with the branch (W16 code-edit traces, all
three with the same 404-405 us lm_head median, so the clocks match). The
straddling CTA still does both stores and sets the kernel's latency -- 3 CTAs
have nothing to hide the extra control flow behind -- so the branch only adds
work. The isolated microbenchmark that suggested otherwise is launch-bound at
this size and does not resolve it.

Back to the plain two-masked-store epilogue: no cost on the 16384-wide qkvz
projection (29.3 us median, unchanged), +0.9 us/call on in_proj_ba at M=16
(W16 only; at M=1/4 it is 5.8 us either way).

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 .../srt/layers/quantization/w8a16_gemv.py     | 49 +++++--------------
 1 file changed, 12 insertions(+), 37 deletions(-)

diff --git a/python/sglang/srt/layers/quantization/w8a16_gemv.py b/python/sglang/srt/layers/quantization/w8a16_gemv.py
index fab3c588f7..33b7e6cd8a 100644
--- a/python/sglang/srt/layers/quantization/w8a16_gemv.py
+++ b/python/sglang/srt/layers/quantization/w8a16_gemv.py
@@ -41,14 +41,12 @@ def _store_split(
     y2_ptr,
     offs_m,
     offs_n,
-    n_lo,
     stride_ym,
     stride_yn,
     stride_y2m,
     m_mask,
     n_mask,
     SPLIT_N: tl.constexpr,
-    BLOCK_N: tl.constexpr,
 ):
     """Write the rounded accumulator to `y`, or to `y`/`y2` split at column SPLIT_N.
 
@@ -56,43 +54,24 @@ def _store_split(
     original epilogue. With SPLIT_N > 0 columns [0, SPLIT_N) land in `y` and
     columns [SPLIT_N, N) land in `y2` at column `n - SPLIT_N`; both stores see
     the same rounded value, so the numerics are identical either way.
-
-    An n block that lies wholly on one side of the split (every block, when
-    BLOCK_N divides SPLIT_N) takes a single unconditional store; only a block
-    that straddles the split pays for two masked ones.
     """
     # Round to bf16 first even when the destination is fp32: an fp32 destination
     # is only ever the shared logits buffer, whose old contents were a bf16
     # result widened by `.copy_()`. Rounding here keeps that bit-identical.
     val = acc.to(tl.bfloat16).to(y_ptr.dtype.element_ty)
     if SPLIT_N > 0:
-        if n_lo + BLOCK_N <= SPLIT_N:
-            tl.store(
-                y_ptr + offs_m[:, None] * stride_ym + offs_n[None, :] * stride_yn,
-                val,
-                mask=m_mask[:, None] & n_mask[None, :],
-            )
-        elif n_lo >= SPLIT_N:
-            tl.store(
-                y2_ptr
-                + offs_m[:, None] * stride_y2m
-                + (offs_n - SPLIT_N)[None, :] * stride_yn,
-                val,
-                mask=m_mask[:, None] & n_mask[None, :],
-            )
-        else:
-            lo = offs_n < SPLIT_N
-            tl.store(
-                y_ptr + offs_m[:, None] * stride_ym + offs_n[None, :] * stride_yn,
-                val,
-                mask=m_mask[:, None] & n_mask[None, :] & lo[None, :],
-            )
-            n2 = tl.maximum(offs_n - SPLIT_N, 0)
-            tl.store(
-                y2_ptr + offs_m[:, None] * stride_y2m + n2[None, :] * stride_yn,
-                val,
-                mask=m_mask[:, None] & n_mask[None, :] & (offs_n >= SPLIT_N)[None, :],
-            )
+        lo = offs_n < SPLIT_N
+        tl.store(
+            y_ptr + offs_m[:, None] * stride_ym + offs_n[None, :] * stride_yn,
+            val,
+            mask=m_mask[:, None] & n_mask[None, :] & lo[None, :],
+        )
+        n2 = tl.maximum(offs_n - SPLIT_N, 0)
+        tl.store(
+            y2_ptr + offs_m[:, None] * stride_y2m + n2[None, :] * stride_yn,
+            val,
+            mask=m_mask[:, None] & n_mask[None, :] & (offs_n >= SPLIT_N)[None, :],
+        )
     else:
         tl.store(
             y_ptr + offs_m[:, None] * stride_ym + offs_n[None, :] * stride_yn,
@@ -188,14 +167,12 @@ def _w8a16_gemv_kernel(
             y2_ptr,
             offs_m,
             offs_n,
-            pid_n * BLOCK_N,
             stride_ym,
             stride_yn,
             stride_y2m,
             m_mask,
             n_mask,
             SPLIT_N,
-            BLOCK_N,
         )
         return
 
@@ -220,14 +197,12 @@ def _w8a16_gemv_kernel(
             y2_ptr,
             offs_m,
             offs_n,
-            pid_n * BLOCK_N,
             stride_ym,
             stride_yn,
             stride_y2m,
             m_mask,
             n_mask,
             SPLIT_N,
-            BLOCK_N,
         )
         # Every increment for this N block has happened, so a plain store is enough to
         # leave the counter at 0 for the next launch / graph replay.
-- 
